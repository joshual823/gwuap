# From Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER expose to the browser.
# Also from Project Settings > API. Used only in app/api/admin routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostHog — session replay, heatmaps and funnels. The project token is
# meant to be public: it ships in the browser bundle, which is why it's
# NEXT_PUBLIC_. Project Settings > Project API Key, starts "phc_".
# Leave it unset and PostHog never loads at all.
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-token
# Leave unset. Events go to /ingest, a same-origin path rewritten to
# PostHog in next.config.js so ad blockers can't drop them by hostname.
# Set this only to bypass the proxy — e.g. EU cloud, where you'd also
# need to repoint the rewrites.
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
